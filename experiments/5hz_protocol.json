{
  "protocol": "registered_5hz_8train_3blind_v1",
  "purpose": "Test 5 Hz source-conditioned forward generalization before localization",
  "frequency_hz": 5.0,
  "training": {
    "seed": 42,
    "steps": 5000,
    "n_phys": 256,
    "n_ic": 128,
    "n_bc_per_face": 16,
    "receiver_batch_size": 1024,
    "receiver_loss_weight": 0.1,
    "learning_rate": 0.0001,
    "wavefield_scale": 0.00001,
    "source_near_fraction": 0.5,
    "source_spatial_jitter_sigma": 0.75,
    "source_temporal_half_width_periods": 0.25,
    "architecture": "harmonic_carrier_hard_initial",
    "checkpoint_selection": "final_5000_steps_no_blind_selection"
  },
  "data": {
    "development_only": ["event_01.npz", "heldout_01.npz"],
    "training_sources": [
      {"file": "train_01.npz", "source": [3500, 4000, 500, 0.12]},
      {"file": "train_02.npz", "source": [11500, 4000, 900, 0.28]},
      {"file": "train_03.npz", "source": [4000, 12000, 1200, 0.36]},
      {"file": "train_04.npz", "source": [12000, 12000, 400, 0.18]},
      {"file": "train_05.npz", "source": [8000, 3000, 1300, 0.42]},
      {"file": "train_06.npz", "source": [3000, 8000, 800, 0.31]},
      {"file": "train_07.npz", "source": [9000, 12500, 1100, 0.09]},
      {"file": "train_08.npz", "source": [13000, 8000, 600, 0.39]}
    ],
    "blind_sources": [
      {"file": "blind_01.npz", "source": [6000, 6000, 350, 0.24]},
      {"file": "blind_02.npz", "source": [10500, 9500, 1000, 0.33]},
      {"file": "blind_03.npz", "source": [7000, 11000, 1400, 0.16]}
    ]
  },
  "evaluation": {
    "metric": "original_amplitude_relative_L2_vs_independent_FD",
    "zero_prediction_baseline": 1.0,
    "minimum_feasibility": "every_blind_event_relative_L2_less_than_1",
    "stronger_forward_target": "blind_median_relative_L2_less_than_0.5",
    "selection": "assess_final_5000_step_checkpoint_once_no_retuning_from_blind"
  }
}
